{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/desktop-feature-engineer/work-graph.schema.json",
  "title": "Desktop Feature Engineer Work Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "goal", "mode", "acceptanceCriteria", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["guided", "plan-only", "auto"] },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "goal", "kind", "dependencies", "inputs", "outputs",
          "acceptance", "checks", "risk", "status", "attempts", "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "discovery", "contract", "domain", "runtime", "ipc", "persistence",
              "ui", "observability", "migration", "test", "packaging", "security", "review"
            ]
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "risk": { "enum": ["low", "medium", "high"] },
          "status": {
            "enum": ["pending", "ready", "in_progress", "verified", "blocked", "failed", "skipped", "deferred"]
          },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "blocker": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
